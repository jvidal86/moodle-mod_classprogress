{{!
    @template mod_classprogress/entry_context

    What the entry page shows above its form: the planned day, the left-over of the previous session, and the saved
    entry's written-on day, late flag and links.

    Context variables required for this template:
    * hasitem - Whether the entry is for a plan item.
    * date, block, title - The item's day, and its block and title as typed (escaped here).
    * hours - Planned hours; empty when unknown.
    * content - The day's plan, already through format_text().
    * hasleftover, leftover - What the previous session left over, already through format_text().
    * hasentry - Whether the entry is saved.
    * writtenon, late, lastedited - Sentences about the saved entry; late is empty when it was not late.
    * deleteurl, historyurl - Links to delete the entry and to see its history.

    Example context (json):
    {
        "hasitem": true,
        "date": "2026-10-16",
        "block": "RA1 · Reconeix els elements",
        "title": "Entorn",
        "hours": "2",
        "content": "<ul><li>Instal·lació de l'IDE</li></ul>",
        "hasleftover": true,
        "leftover": "<p>Mig exercici 3</p>",
        "hasentry": true,
        "writtenon": "Written on 2026-10-18.",
        "late": "Late by 2 days",
        "lastedited": "Last edited Sunday, 18 October 2026, 12:00 PM.",
        "deleteurl": "https://example.com/local/classprogress/entry.php?id=1&action=delete",
        "historyurl": "https://example.com/local/classprogress/history.php?id=1"
    }
}}
<div class="mod_classprogress-entry">
    {{#hasitem}}
        <section class="card mb-3" data-region="planned-day">
            <div class="card-body">
                <h4 class="card-title">{{#str}} plannedday, mod_classprogress {{/str}}</h4>
                <p class="text-muted">{{date}}{{#hours}} · {{hours}} h{{/hours}}{{#block}} · {{block}}{{/block}}{{#title}} · {{title}}{{/title}}</p>
                {{{content}}}
            </div>
        </section>
    {{/hasitem}}
    {{#hasleftover}}
        <section class="alert alert-info" data-region="left-over">
            <h4>{{#str}} leftover, mod_classprogress {{/str}}</h4>
            {{{leftover}}}
        </section>
    {{/hasleftover}}
    {{#hasentry}}
        <p data-region="entry-written">
            {{writtenon}}{{#late}} <span class="badge bg-warning text-dark">{{late}}</span>{{/late}} {{lastedited}}
        </p>
        <p>
            <a class="btn btn-secondary" href="{{historyurl}}">{{#str}} history, mod_classprogress {{/str}}</a>
            <a class="btn btn-link" href="{{deleteurl}}">{{#str}} deleteentry, mod_classprogress {{/str}}</a>
        </p>
    {{/hasentry}}
</div>
