{{!
    @template mod_classprogress/export_view

    The export page of an approved plan: the summary tables of the file and the link that downloads it.

    Context variables required for this template:
    * today - The teacher's own day the figures are computed for, yyyy-mm-dd.
    * downloadurl - The URL that downloads the XLSX file.
    * tables - The overall, per block and per evaluation period tables, each with id, title, headers (the column
      headers) and rows, each with cells (the group name as typed, escaped here, then the figures as text).

    Example context (json):
    {
        "today": "2026-10-18",
        "downloadurl": "https://example.com/mod/classprogress/export.php?id=1&download=1",
        "tables": [{"id": "export-overall", "title": "Overall",
            "headers": ["Group", "Planned", "Done", "Partly done", "Not done", "Not logged", "Upcoming", "Added",
                "Coverage (%)", "Planned hours", "Hours done", "Hours not done", "Written late", "Most days late"],
            "rows": [{"cells": ["All sessions", "10", "2", "1", "2", "4", "1", "2", "28", "18.5", "4.75", "4.75", "2",
                "5"]}]}]
    }
}}
<div class="mod_classprogress-export">
    <p>{{#str}} exportintro, mod_classprogress, {{today}} {{/str}}</p>
    <p data-region="export-download">
        <a class="btn btn-primary" href="{{downloadurl}}">{{#str}} exportdownload, mod_classprogress {{/str}}</a>
    </p>
    {{#tables}}
        <section class="mt-4" data-region="{{id}}">
            <h3 id="{{id}}-title">{{title}}</h3>
            {{! A wide table scrolls sideways; the keyboard reaches its scroll area, named by the heading. }}
            <div class="table-responsive" tabindex="0" role="region" aria-labelledby="{{id}}-title">
                <table class="generaltable" id="{{id}}">
                    <thead>
                        <tr>
                            {{#headers}}
                                <th scope="col">{{.}}</th>
                            {{/headers}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                {{#cells}}
                                    <td>{{.}}</td>
                                {{/cells}}
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        </section>
    {{/tables}}
</div>
